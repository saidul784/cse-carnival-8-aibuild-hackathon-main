# Copy this file to .env and fill in your values
# Never commit your actual .env file

# ─────────────────────────────────────────────────────────────
# LLM configuration  (server-side only — never exposed to the browser)
# ─────────────────────────────────────────────────────────────
# Which provider the AI agent should use.
# One of: anthropic | openai | groq | google
# Leave blank to auto-detect the first provider whose key is set.
# If set explicitly, that provider is used strictly: a missing key is an
# error rather than a silent fallback to another vendor.
LLM_PROVIDER=anthropic

# Set the key for the provider you chose above. Only ONE is required.
ANTHROPIC_API_KEY=your_key_here
OPENAI_API_KEY=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
GROQ_API_KEY=your_key_here
GOOGLE_API_KEY=your_key_here

# Optional model overrides (sensible defaults are used when unset)
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# GOOGLE_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# SQLite file, created by `npm run db:migrate` and filled by `npm run db:seed`.
DATABASE_URL="file:./dev.db"

# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────
PORT=3000

# ─────────────────────────────────────────────────────────────
# Demo identity
# ─────────────────────────────────────────────────────────────
# The seed data has no student entity, so the assistant needs an identity to
# resolve "my classes" and to attribute bookings and registrations.
# DEMO_STUDENT_ID=20-40600
# DEMO_STUDENT_NAME=Demo Student
# DEMO_ROLE=student

# Pin the app's idea of "now" (ISO timestamp). Unset = real system clock.
# Useful for demonstrating against the September 2026 seed dates.
# DEMO_NOW=2026-09-04T10:00:00
